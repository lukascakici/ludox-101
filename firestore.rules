rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Lobbies — public game rooms.
    match /lobbies/{lobbyId} {
      // Any signed-in user (guest or registered) can browse lobbies.
      allow read: if request.auth != null;

      // A signed-in user may create a lobby only as themselves (host).
      allow create: if request.auth != null
        && request.resource.data.hostId == request.auth.uid;

      // The host can change anything. Other signed-in players may only
      // join/leave: i.e. the ONLY field that changes is `players`, the lobby is
      // still waiting, and capacity is not exceeded.
      allow update: if request.auth != null && (
        resource.data.hostId == request.auth.uid
        || (
          resource.data.status == 'WAITING'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'playerUids'])
          && request.resource.data.players.size() <= resource.data.maxPlayers
        )
      );

      // Only the host can delete (disband) the lobby.
      allow delete: if request.auth != null
        && resource.data.hostId == request.auth.uid;
    }

    // Per-user match history. Properly scoped: a user reads/writes ONLY their own
    // history. Anonymous users simply never write here (the client gates on it).
    match /users/{uid}/history/{matchId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Game state. Pragmatic / client-authoritative for now (tighten later).
    match /games/{gameId} {
      // Public game state: any signed-in user may read/write.
      allow read, write: if request.auth != null;

      // Hands. Pragmatic / client-authoritative: any signed-in participant can
      // read AND write any hand. Reading others' hands is REQUIRED so that when a
      // player disconnects, another client can auto-play their turn (the table
      // auto-continues). Tradeoff accepted (like okeyCount): the official UI never
      // shows opponents' tiles, but they are technically visible in the DB.
      match /hands/{uid} {
        allow read, write: if request.auth != null;
      }

      // Draw pile and move log: readable/writable by any signed-in user.
      match /private/{docId} {
        allow read, write: if request.auth != null;
      }
      match /moves/{moveId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
